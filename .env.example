# ---------------------------------------------------------------------------
# Copy this file to .env.local and fill in real values.
# Never commit .env.local — it is git-ignored.
# ---------------------------------------------------------------------------

# MySQL/MariaDB via XAMPP. Create the database first using phpMyAdmin
# (http://localhost/phpmyadmin) — see README "XAMPP Setup".
DATABASE_URL="mysql://root:@localhost:3306/employee_work_management"

# Upstash Redis (Free Tier). Use the REST API credentials, not the raw
# redis:// connection string. https://console.upstash.com/
UPSTASH_REDIS_REST_URL=""
UPSTASH_REDIS_REST_TOKEN=""

# Auth.js / NextAuth session encryption secret.
# Generate with: openssl rand -base64 32
AUTH_SECRET=""

# Public URL of the app (used for absolute links).
NEXT_PUBLIC_APP_URL="http://localhost:3000"

# Used by `npm run db:seed`.
# Email/password for the first Super Admin. Without SUPER_ADMIN_PASSWORD
# the account is created with no password and cannot sign in (auth is
# email/password only — there is no OAuth fallback).
# SUPER_ADMIN_EMAIL=""
# SUPER_ADMIN_PASSWORD=""
# Set to "false" to skip seeding the demo project/tasks/chat room.
# SEED_DEMO_DATA="true"

# Video/audio meetings run on a Jitsi Meet server. Defaults to the public
# https://meet.jit.si. For heavy or long-running use, point this at your own
# self-hosted Jitsi server. In-app rooms only load the player from this host.
# NEXT_PUBLIC_JITSI_BASE_URL="https://meet.jit.si"

# Minutes of inactivity before a user is signed out automatically (default 5).
# Enforced by the server as well as the browser.
# NEXT_PUBLIC_IDLE_TIMEOUT_MINUTES="5"

# Forgot-password e-mails (6-digit one-time code) are sent through Gmail.
# Option A (simplest): a Google "App password" for the sending account
#   (Google Account -> Security -> 2-Step Verification -> App passwords).
# GMAIL_USER="yourname@gmail.com"
# GMAIL_APP_PASSWORD="xxxx xxxx xxxx xxxx"
# Option B: Google OAuth2 (set all three instead of GMAIL_APP_PASSWORD).
# GMAIL_CLIENT_ID=""
# GMAIL_CLIENT_SECRET=""
# GMAIL_REFRESH_TOKEN=""
# Optional display name/address for the From header.
# MAIL_FROM="High Dense Office <yourname@gmail.com>"
# Without Gmail configured, in development the code is printed to the server console instead of e-mailed.
